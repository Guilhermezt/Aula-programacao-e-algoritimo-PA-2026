programa
{
	
	funcao inicio()
	{
	cadeia nome
	real mo,m15,m20
		escreva("Olá qual seu nome?\n")
		leia(nome)
		escreva("Qual seu peso em kg?\n")
		leia(mo)

		m15=mo*1.15
		m20=mo*0.8
		escreva(nome," se voce engordar em 15% seu novo peso sera de ",m15,"kg\n")
		escreva(nome, " se voce emagrecer 20% seu novo peso sera de ",m20,"kg\n")
	}
}
