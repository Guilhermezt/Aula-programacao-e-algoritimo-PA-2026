programa
{
	
	funcao inicio()
	{
	real altura, raio, volume
	
		escreva("Qual a altura do cilindro?\n")
		leia(altura)
		escreva("Qual o raio do cilindro\n")
		leia(raio)

		volume= 3.14159 *(raio * raio)* altura

		escreva("O volume do seu cilindro é igual a ",volume)

	}
}
