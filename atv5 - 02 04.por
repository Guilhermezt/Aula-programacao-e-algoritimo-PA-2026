programa
{
	
	funcao inicio()
	{
	real sl, sln
		escreva("Insira seu sálario atual\n")
		leia(sl)

		sln=sl*1.3

		se(sl<1000)
		{
		escreva("Você recebeu o aumento seu novo sálario é de ", sln)
		}
		senao escreva("Você não pode receber o aumento")
	}
}
