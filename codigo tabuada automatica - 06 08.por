programa
{
    funcao inicio()
    {
        inteiro n, i

        para (n = 0; n<=10; n++)
        {
        para (i = 1; i <= 10; i++)
        {
            escreva(n, " x ", i, " = ", (n * i), "\n")
        }
        escreva("\n")
        }
    }
}

