programa
{
	
	funcao inicio()
	{
	real dist, t, vm
		escreva("Quanto tempo levou para chegar em minutos?\n")
		leia(t)
		escreva("Qual a distancia em km?\n")
		leia(dist)

		vm=dist/t

		escreva("Sua velocidade media era igual a: ",vm, "km/m")
	}
}
