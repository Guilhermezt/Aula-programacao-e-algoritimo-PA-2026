programa
{
	
	funcao inicio()
	{

	inteiro contador
     
	//contador ++ é igual a contador = contador + 1
	para(contador = 1; contador <=100; contador++) 
	{
		se(contador%2==0)
		{
			escreva(contador, " Par", "\n")	
		}
		senao
		{
			escreva(contador, " Impar", "\n")	
		}
	}
	
	


	
	}
}

//ATV 1:
//Faça um algoritimo de 1 ate 100 usando laço de repetição para, separe os números pares dos impares

