programa
{
	
	funcao inicio()
	{
	inteiro C,F
		escreva("Coloque o valor em graus celsius abaixo:\n")
		leia(C)
		F=(9 * C + 160) / 5
		escreva(C ," graus celsius equivalem a ", F ," graus Fahrenheit")
 
		
		
	}
}
