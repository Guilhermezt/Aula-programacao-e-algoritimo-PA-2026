programa
{
	funcao inicio()
	{
		inteiro mes

		escreva("Digite o número do mês: ")
		leia(mes)

		escolha(mes)
		{
			caso 1:
				escreva("Confraternização Universal")
				pare

			caso 4:
				escreva("Tiradentes")
				pare

			caso 5:
				escreva("Dia do Trabalhador")
				pare

			caso 9:
				escreva("Independência do Brasil")
				pare

			caso 10:
				escreva("Nossa Senhora Aparecida")
				pare

			caso 11:
				escreva("Finados e Proclamação da República")
				pare

			caso 12:
				escreva("Natal")
				pare

			caso contrario:
				escreva("Sem feriado/mês invalido")
		}
	}
}
