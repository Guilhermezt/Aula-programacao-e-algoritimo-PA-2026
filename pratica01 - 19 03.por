programa
{
	
	funcao inicio()
	{
		cadeia nome
		inteiro idade, dias
		
		escreva("Qual seu nome?")
		leia(nome) 
		
		escreva("Qual sua idade?")
		leia(idade)
		
		dias=idade*365
		escreva(nome," Você já viveu ",dias, " dias")
	}
}
