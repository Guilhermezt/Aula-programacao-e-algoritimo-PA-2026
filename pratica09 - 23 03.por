programa
{
	
	funcao inicio()
	{
	real x, y
		escreva("Coloque um valor para x\n")
		leia(y)
		escreva("coloque um valor para y\n")
		leia(x)


		escreva("X é igual a ",x," \nY é igual a ",y)
	}
}
