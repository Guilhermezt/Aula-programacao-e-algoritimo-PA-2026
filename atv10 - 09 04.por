programa
{ 

        funcao inicio()
        {
          real n        
		escreva("Insira o número\n")
		leia(n)

		se(n>0){
		escreva("\nSeu número é positivo\n")
		}

        senao se(n==0){
            escreva("\nSeu número é nulo")
        }
        
		senao{
		escreva("\nSeu número é negativo\n")
		}
}
    }
