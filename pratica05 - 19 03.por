programa
{
	
	funcao inicio()
	{
	
	real n1,n2,nf
	cadeia nome
	
		escreva("Qual seu nome?\n")
		leia(nome)
		escreva("1° nota: \n")
		leia(n1)
		escreva("2° nota:\n")
		leia(n2)

		nf=(n1+n2)/2

		escreva(nome," sua media final foi igual a: \n",nf)
	}
}
