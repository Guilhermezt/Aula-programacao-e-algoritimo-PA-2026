programa
{
	
	funcao inicio()
	{
	cadeia nome
	real eu,li,dol,rs
	
		escreva("Olá qual seu nome?\n")
		leia(nome)
		escreva("quantos reais você tem?\n")
		leia(rs)

		eu=rs*6.04
		li=rs*6.98
		dol=rs
		*5.23

		escreva("Você tem ",dol," dolares\n")
		escreva("Você tem ",eu," euros\n")
		escreva("Você tem ",li," libras\n")
		
	}
}
