programa
{
    funcao inicio()
    {
        inteiro n, i

        n=0
        i=0

        enquanto (n<=9)
        {
        n = n+1
        para (i = 1; i <= 10; i++)
        {
        
            escreva(n, " x ", i, " = ", (n * i), "\n")
        }
        escreva("\n")
        }
    }
}

//faça a tabuada do um até o 10 utilizando o enquanto.